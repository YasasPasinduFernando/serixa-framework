{
    "name": "serixa/framework",
    "description": "SERIXA \u2014 a Flutter-inspired PHP UI framework. Write PHP widgets, get semantic HTML.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/YasasPasinduFernando/serixa",
    "support": {
        "issues": "https://github.com/YasasPasinduFernando/serixa/issues",
        "source": "https://github.com/YasasPasinduFernando/serixa",
        "docs": "https://github.com/YasasPasinduFernando/serixa/tree/main/docs"
    },
    "keywords": [
        "serixa",
        "php",
        "ui",
        "widgets",
        "components",
        "html",
        "tailwind",
        "flutter"
    ],
    "authors": [
        {
            "name": "SERIXA Contributors",
            "homepage": "https://github.com/YasasPasinduFernando/serixa"
        }
    ],
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Serixa\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Serixa\\Tests\\": "tests/"
        }
    },
    "suggest": {
        "serixa/cli": "Official scaffolding CLI (serixa new, make:*, build, docs)"
    },
    "scripts": {
        "test": "phpunit",
        "phpstan": "phpstan analyse --memory-limit=512M",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "cs-fix": "php-cs-fixer fix",
        "qa": [
            "@test",
            "@phpstan",
            "@cs-check"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
