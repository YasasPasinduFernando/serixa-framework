<?php

declare(strict_types=1);

namespace App\Pages;

use App\Layouts\AppLayout;
use Serixa\Component\Column;
use Serixa\Component\Text;
use Serixa\Document\Document;

/**
 * CRM contacts overview.
 */
final class ContactsPage
{
    public static function document(): Document
    {
        $body = Column::make([
            AppLayout::titleBar('Contacts'),
            Text::make('Manage customer relationships.')->tone('muted'),
        ])->gap(3);

        return Document::make()->title('Contacts · {{ProjectName}}')->body($body);
    }
}
