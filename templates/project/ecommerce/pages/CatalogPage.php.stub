<?php

declare(strict_types=1);

namespace App\Pages;

use App\Layouts\AppLayout;
use Serixa\Component\Column;
use Serixa\Component\Text;
use Serixa\Document\Document;

/**
 * Ecommerce catalog page.
 */
final class CatalogPage
{
    public static function document(): Document
    {
        $body = Column::make([
            AppLayout::titleBar('Catalog'),
            Text::make('Browse products powered by SERIXA SSR.')->tone('muted'),
        ])->gap(3);

        return Document::make()->title('Catalog · {{ProjectName}}')->body($body);
    }
}
